# Paystack Payment Gateway Configuration (Template)
# Replace with your actual Paystack API keys in your local .env file
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# Global Multi-Device Cloud Sync Configuration (Optional)
# Can also be configured directly via Admin Dashboard -> Cloud & Multi-Device Sync
# VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# VITE_CLOUD_SYNC_URL=https://your-project-default-rtdb.firebaseio.com
# VITE_CLOUD_SYNC_TOKEN=your_database_secret_or_token
